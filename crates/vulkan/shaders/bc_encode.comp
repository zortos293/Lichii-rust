// Compresses a band of RGBA8 texels (astc_decode.comp's output, width per row) to BC1 or BC3, one
// 4x4 block per invocation, so recompressed ASTC never round-trips through the CPU. A port of the
// CPU encoder (lichii_texture::bcn::encode_bc1/encode_bc3): colour endpoints from the principal
// axis of the block's colours, refined once by least squares, uniform blocks from exact
// single-colour tables, every texel on its nearest palette entry. Values are encoded as stored
// (sRGB data stays sRGB). Edge blocks repeat the last row and column. Float steps are precise, so
// only division rounding can move an endpoint away from the CPU's.

#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Texels { uint rgba[]; };
layout(set = 0, binding = 1) writeonly buffer Blocks { uvec2 blocks[]; };

layout(push_constant) uniform P {
    uint blocks_x;
    uint blocks_y;
    uint width;
    uint height;
    uint bc3;
    uint in_offset;
    uint out_offset;
} p;

