// Unpacks the grid of a version 1.x compute launch descriptor (words 0xc and 0xd: the width in
// bits 0..30, then the height and depth as 16-bit halves) into a VkDispatchIndirectCommand,
// clamped to the device's workgroup count limits.

#version 460

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Grid { uint grid[]; };
layout(set = 0, binding = 1) writeonly buffer Command { uint command[]; };

layout(push_constant) uniform P {
    uvec3 limit;
    uint grid_word;
} p;

void main() {
    uint height_depth = grid[p.grid_word + 1u];
    uvec3 size = uvec3(grid[p.grid_word] & 0x7fffffffu, height_depth & 0xffffu, height_depth >> 16u);
    uvec3 clamped = min(size, p.limit);
    command[0] = clamped.x;
    command[1] = clamped.y;
    command[2] = clamped.z;
}
