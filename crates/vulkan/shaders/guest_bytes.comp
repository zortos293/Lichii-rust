// Moves the slices of one block-linear level between a pitch-linear buffer and a buffer of guest bytes, one 32-bit
// word per invocation, slices z_base onwards along z. A row's last word may hold fewer texel bytes than four: the move
// to the guest writes only those and keeps the guest's other bytes. Mirrors lichii_texture::block_linear (Tiling::offset
// and GobLayout). Each word's image offset is looked up in the runs of shared device memory, so a
// slice can be painted into the bytes of a smaller image it overlaps in one pass; words outside
// every run are skipped. Rows start at y_base, so a pass covers only the block rows the runs
// touch. Depth-stencil packings combine a
// depth word per texel with stencil bytes packed four to a word; X8D24 keeps its high byte zero and has no stencil.
// With depth_float the host's depth word is a float, converted to and from the guest's 24-bit unorm exactly as
// the CPU path's f64 arithmetic does.

#version 460

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Guest { uint guest[]; };
layout(set = 0, binding = 1) buffer Linear { uint linear_words[]; };
layout(set = 0, binding = 2) buffer Stencil { uint stencil_words[]; };
// (image offset, size, guest buffer offset, unused) per run, sorted by image offset.
layout(set = 0, binding = 3) readonly buffer Runs { uvec4 runs[]; };

const uint TO_GUEST = 0u;
const uint PLAIN = 0u;
const uint DEPTH_LOW_STENCIL_HIGH = 1u;
const uint STENCIL_LOW_DEPTH_HIGH = 2u;
const uint DEPTH_LOW_ZERO_HIGH = 3u;

layout(push_constant) uniform P {
    uint row_words;
    uint row_bytes;
    uint height;
    uint row_gobs;
    uint block_height_log2;
    uint block_depth_log2;
    uint switch2_layout;
    uint subresource;
    uint run_first;
    uint run_count;
    uint y_base;
    uint direction;
    uint packing;
    uint stencil_pitch;
    uint depth_float;
    uint z_base;
} p;

const float D24_MAX = 16777215.0;
const uint D24_INV_BITS = 0x33800001u;

float d24_to_float(uint d) {
    float inv = uintBitsToFloat(D24_INV_BITS);
    precise float x = float(d);
    precise float q = x * inv;
    precise float r = fma(-q, D24_MAX, x);
    precise float f = fma(r, inv, q);
    return f;
}

uint float_to_d24(float depth) {
    float f = depth >= 0.0 ? min(depth, 1.0) : 0.0;
    precise float product = f * D24_MAX;
    precise float error = fma(f, D24_MAX, -product);
    float nearest = roundEven(product);
    precise float frac = (product - nearest) + error;
    uint d = uint(nearest);
    if (frac >= 0.5) {
        d += 1u;
    } else if (frac < -0.5) {
        d -= 1u;
    }
    return d;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y + p.y_base;
    uint z = gl_GlobalInvocationID.z + p.z_base;
    if (x >= p.row_words || y >= p.height) {
        return;
    }
    uint bh = p.block_height_log2;
    uint xb = x * 4u;
    uint bd = p.block_depth_log2;
    uint x_shift = 9u + bh + bd;
    uint block_size = p.row_gobs << x_shift;
    uint slab_size = ((p.height + (8u << bh) - 1u) >> (3u + bh)) * block_size;
    uint gob_y = y >> 3u;
    uint base = (z >> bd) * slab_size + ((z & ((1u << bd) - 1u)) << (9u + bh)) + (gob_y >> bh) * block_size + ((gob_y & ((1u << bh) - 1u)) << 9u) + ((xb >> 6u) << x_shift);
    uint in_gob = ((xb & 32u) << 3u) | ((xb & 16u) << 1u) | (xb & 15u) | ((y & 6u) << 5u) | ((y & 1u) << 4u);
    if (p.switch2_layout != 0u) {
        uint differ = ((in_gob >> 5u) ^ (in_gob >> 6u)) & 1u;
        in_gob ^= (differ << 5u) | (differ << 6u);
    }
    uint offset = p.subresource + base + in_gob;
    uint lo = p.run_first;
    uint hi = p.run_first + p.run_count;
    while (lo + 1u < hi) {
        uint mid = (lo + hi) >> 1u;
        if (runs[mid].x <= offset) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    uvec4 run = runs[lo];
    if (offset < run.x || offset - run.x >= run.y) {
        return;
    }
    uint word = (run.z + offset - run.x) >> 2u;
    uint texel = (z * p.height + y) * p.row_words + x;
    uint s_index = y * p.stencil_pitch + x;
    uint s_shift = (s_index & 3u) * 8u;
    if (p.direction == TO_GUEST) {
        uint value = linear_words[texel];
        if (p.packing != PLAIN) {
            if (p.depth_float != 0u) {
                value = float_to_d24(uintBitsToFloat(value));
            }
            value &= 0xFFFFFFu;
            if (p.packing != DEPTH_LOW_ZERO_HIGH) {
                uint s = (stencil_words[s_index >> 2u] >> s_shift) & 0xFFu;
                value = p.packing == DEPTH_LOW_STENCIL_HIGH ? value | (s << 24u) : s | (value << 8u);
            }
        }
        uint texel_bytes = p.row_bytes - xb;
        if (texel_bytes < 4u) {
            uint mask = (1u << (texel_bytes * 8u)) - 1u;
            value = (guest[word] & ~mask) | (value & mask);
        }
        guest[word] = value;
    } else {
        uint value = guest[word];
        if (p.packing == PLAIN) {
            linear_words[texel] = value;
        } else {
            uint d = p.packing == STENCIL_LOW_DEPTH_HIGH ? value >> 8u : value & 0xFFFFFFu;
            linear_words[texel] = p.depth_float != 0u ? floatBitsToUint(d24_to_float(d)) : d;
            if (p.packing != DEPTH_LOW_ZERO_HIGH) {
                uint s = p.packing == DEPTH_LOW_STENCIL_HIGH ? value >> 24u : value & 0xFFu;
                atomicAnd(stencil_words[s_index >> 2u], ~(0xFFu << s_shift));
                atomicOr(stencil_words[s_index >> 2u], s << s_shift);
            }
        }
    }
}
